NODE_ENV=development
PORT=3000
# Optional host port overrides when local services occupy the defaults.
MONGO_PORT=27017
REDIS_PORT=6379
API_PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/day_recharge?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=recharge
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
WEBHOOK_SECRET=
PLATFORM_HOSTS=localhost,platform.localhost
SHARED_API_HOSTS=api.localhost
PLATFORM_ORIGINS=http://localhost:3000,http://localhost:5179,http://platform.localhost:5179
# Exact proxy IPs or CIDRs; leave empty for direct local traffic.
TRUSTED_PROXIES=
# false only for HTTP localhost development
COOKIE_SECURE=false
MOCK_PROVIDER_ENABLED=true
LOG_LEVEL=info
# Optional HTTPS internal email-delivery service; reset flow returns 503 until configured.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_SECRET=

# Website image uploads (optional until you configure your bucket).
S3_REGION=
S3_BUCKET=
# Public HTTPS image origin, e.g. https://images.example.com (no trailing /website).
S3_PUBLIC_BASE_URL=
# Use an IAM role in production, or configure the standard AWS credential chain locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
